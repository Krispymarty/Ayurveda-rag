# Provider-managed secrets; never commit the completed file.
DATABASE_URL=postgresql://APP_USER:REPLACE_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full&sslrootcert=system
AYURIP_DEPLOYMENT_MODE=public_research
AYURIP_PUBLIC_ORIGIN=https://REPLACE_WITH_REAL_DOMAIN
AYURIP_ALLOWED_HOSTS=
AYURIP_SNAPSHOT_SHA256=REPLACE_WITH_PREPARED_RELEASE_MANIFEST_SHA256
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PORT=8000
# Keep off until the hosted release gates pass. Enable only for the selected image.
AYURIP_HOSTED_ANSWERS=0
# Configure these as secrets when rehearsing or enabling hosted extracts.
AYURIP_ANSWER_COOKIE_KEY=
AYURIP_ANSWER_QUOTA_DSN=
GROQ_API_KEY=
GEMINI_API_KEY=
AYURIP_LLM_PROVIDER=groq
AYURIP_GROQ_MODEL=qwen/qwen3.8-27b
AYURIP_GEMINI_MODEL=gemini-3.5-flash-lite
AYURIP_FALLBACK_PROVIDER=gemini
# The private Passport and synchronization have separate deployment boundaries.
