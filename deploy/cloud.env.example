# Provider-managed secrets; never commit the completed file.
DATABASE_URL=postgresql://APP_USER:REPLACE_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full&sslrootcert=system
AYURIP_DEPLOYMENT_MODE=public_research
AYURIP_PUBLIC_ORIGIN=https://REPLACE_WITH_REAL_DOMAIN
AYURIP_ALLOWED_HOSTS=
AYURIP_SNAPSHOT_SHA256=REPLACE_WITH_PREPARED_RELEASE_MANIFEST_SHA256
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PORT=8000
# Public AI/Passport, candidate workers and synchronization are not deployed.
