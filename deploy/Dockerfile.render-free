FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
WORKDIR /app
COPY deploy/runtime-lock.txt /tmp/runtime-lock.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    awk '!/^(huggingface_hub|hf-xet|safetensors|sentence-transformers|tokenizers|transformers|scikit-learn|scipy|numpy|networkx|sympy|mpmath|threadpoolctl|joblib|fsspec)==/' /tmp/runtime-lock.txt > /tmp/search-lock.txt \
    && pip install --timeout 120 --retries 3 -r /tmp/search-lock.txt && pip check
COPY . /app
RUN useradd --system --uid 10001 --create-home ayurip && chmod -R a-w /app
USER 10001:10001
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    AYURIP_DEPLOYMENT_MODE=public_research AYURIP_EMBEDDINGS=remote_e5 PORT=8000
EXPOSE 8000
CMD ["python", "-B", "-m", "tools.cloud_serve"]
