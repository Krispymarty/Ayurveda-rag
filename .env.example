# Copy to .env and replace the password before running Docker Compose.
# Use URL-safe letters and numbers because the value appears in DATABASE_URL.
AYURIP_DB_PASSWORD=replace_with_private_alphanumeric_password
# Set before enabling live source sync.
AYURIP_CONTACT=
# Private Evidence Passport only. Never put this key in frontend JavaScript.
AYURIP_LLM_PROVIDER=groq
AYURIP_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Groq primary credentials; evaluator model overrides remain explicit.
GROQ_API_KEY=
AYURIP_GROQ_MODEL=qwen/qwen3.8-27b
# Explicit local rollback requires AYURIP_LLM_PROVIDER=ollama AND AYURIP_FALLBACK_PROVIDER=none.

# Cloud fallback; use none for explicit single-provider operation.
AYURIP_FALLBACK_PROVIDER=gemini

# Local classroom demo only: 1 enables IP India verified-extract answers with consent.
AYURIP_DEMO_ANSWERS=0
