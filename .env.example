# Copy to .env and replace the password before running Docker Compose.
# Use URL-safe letters and numbers because the value appears in DATABASE_URL.
AYURIP_DB_PASSWORD=replace_with_private_alphanumeric_password
# Set before enabling live source sync.
AYURIP_CONTACT=
# Private Evidence Passport only. Never put this key in frontend JavaScript.
AYURIP_LLM_PROVIDER=gemini
AYURIP_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Private Passport: allow one fresh pinned-Qwen attempt for transient Gemini failures.
# Seven calls per attempt, one shared 90-second deadline. Set 0 to disable fallback.
AYURIP_QWEN_FALLBACK=1
# Optional isolated benchmark only; this does not change the Passport provider.
GROQ_API_KEY=
AYURIP_GROQ_MODEL=openai/gpt-oss-120b
# Explicit local rollback: AYURIP_LLM_PROVIDER=ollama (retained pinned Qwen).
